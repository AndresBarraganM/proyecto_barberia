generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Bloqueo_Temporal {
  Id_bloqueo                                     Int       @id @default(autoincrement())
  Fecha_cita                                     DateTime  @db.Date
  Hora_inicio                                    DateTime  @db.Time(6)
  Expira_en                                      DateTime? @default(dbgenerated("(CURRENT_TIMESTAMP + '00:05:00'::interval)")) @db.Timestamp(6)
  Id_cliente                                     String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Id_estilista                                   String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Usuario_Bloqueo_Temporal_Id_clienteToUsuario   Usuario   @relation("Bloqueo_Temporal_Id_clienteToUsuario", fields: [Id_cliente], references: [Id_usuario], onDelete: NoAction, onUpdate: NoAction)
  Usuario_Bloqueo_Temporal_Id_estilistaToUsuario Usuario   @relation("Bloqueo_Temporal_Id_estilistaToUsuario", fields: [Id_estilista], references: [Id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Citas {
  Id_cita                                    Int          @id @default(autoincrement())
  Id_servicio                                Int?
  Fecha_cita                                 DateTime     @db.Date
  Hora_inicio                                DateTime     @db.Time(6)
  Estado_cita                                Int?
  Id_cliente                                 String       @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Id_estilista                               String       @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Estado_cita_Citas_Estado_citaToEstado_cita Estado_cita? @relation("Citas_Estado_citaToEstado_cita", fields: [Estado_cita], references: [Id_estado_cita], onDelete: NoAction, onUpdate: NoAction)
  Usuario_Citas_Id_clienteToUsuario          Usuario      @relation("Citas_Id_clienteToUsuario", fields: [Id_cliente], references: [Id_usuario], onDelete: NoAction, onUpdate: NoAction)
  Usuario_Citas_Id_estilistaToUsuario        Usuario      @relation("Citas_Id_estilistaToUsuario", fields: [Id_estilista], references: [Id_usuario], onDelete: NoAction, onUpdate: NoAction)
  Servicio                                   Servicio?    @relation(fields: [Id_servicio], references: [Id_Servicio], onDelete: NoAction, onUpdate: NoAction)
  Pago                                       Pago[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Estado_cita {
  Id_estado_cita                       Int     @id @default(autoincrement())
  Estado                               String  @db.VarChar(50)
  Citas_Citas_Estado_citaToEstado_cita Citas[] @relation("Citas_Estado_citaToEstado_cita")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Estado_pago {
  Id_estado_pago Int    @id @default(autoincrement())
  Estado         String @db.VarChar(50)
  Pago           Pago[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Metodo_de_pago {
  id_metodo_pago Int    @id @default(autoincrement())
  Metodo         String @unique @db.VarChar(50)
  Pago           Pago[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Pago {
  Id_cita        Int?
  Monto          Decimal         @db.Decimal(10, 2)
  Id_Metodo_pago Int?
  Fecha_Pago     DateTime?       @default(now()) @db.Timestamptz(6)
  Id_Estado_pago Int?
  Id_pago        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_tarjeta     String?         @db.Uuid
  Estado_pago    Estado_pago?    @relation(fields: [Id_Estado_pago], references: [Id_estado_pago], onDelete: NoAction, onUpdate: NoAction)
  Metodo_de_pago Metodo_de_pago? @relation(fields: [Id_Metodo_pago], references: [id_metodo_pago], onDelete: NoAction, onUpdate: NoAction)
  Citas          Citas?          @relation(fields: [Id_cita], references: [Id_cita], onDelete: NoAction, onUpdate: NoAction)
  Tarjeta        Tarjeta?        @relation(fields: [id_tarjeta], references: [id_tarjeta], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Rol {
  Rol                      String    @db.VarChar(50)
  id_rol                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Usuario_Usuario_RolToRol Usuario[] @relation("Usuario_RolToRol")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Servicio {
  Id_Servicio     Int      @id @default(autoincrement())
  Nombre_Servicio String   @db.VarChar(150)
  Descripcion     String?
  Precio          Decimal  @db.Decimal(10, 2)
  Duracion        DateTime @db.Time(6)
  Citas           Citas[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Tarjeta {
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  numero_tarjeta String   @db.VarChar
  titular        String   @db.VarChar
  vencimiento    DateTime @db.Date
  id_cliente     String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_tarjeta     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Pago           Pago[]
  Usuario        Usuario  @relation(fields: [id_cliente], references: [Id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Usuario {
  Nombre                                                  String             @db.VarChar(100)
  Apellido                                                String             @db.VarChar(100)
  Email                                                   String             @unique @db.VarChar(150)
  Password                                                String
  Fecha_de_registro                                       DateTime?          @default(now()) @db.Timestamptz(6)
  Activo                                                  Boolean?           @default(true)
  telefono                                                String?            @db.VarChar(15)
  Id_usuario                                              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  Rol                                                     String?            @db.Uuid
  Bloqueo_Temporal_Bloqueo_Temporal_Id_clienteToUsuario   Bloqueo_Temporal[] @relation("Bloqueo_Temporal_Id_clienteToUsuario")
  Bloqueo_Temporal_Bloqueo_Temporal_Id_estilistaToUsuario Bloqueo_Temporal[] @relation("Bloqueo_Temporal_Id_estilistaToUsuario")
  Citas_Citas_Id_clienteToUsuario                         Citas[]            @relation("Citas_Id_clienteToUsuario")
  Citas_Citas_Id_estilistaToUsuario                       Citas[]            @relation("Citas_Id_estilistaToUsuario")
  Tarjeta                                                 Tarjeta[]
  Rol_Usuario_RolToRol                                    Rol?               @relation("Usuario_RolToRol", fields: [Rol], references: [id_rol], onDelete: NoAction, onUpdate: NoAction)
  token                                                   token[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model token {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime  @db.Timestamp(6)
  Id_usuario String    @db.Uuid
  token      String
  expired_at DateTime  @db.Timestamp(6)
  revoked_at DateTime? @db.Timestamp(6)
  user_agent String?
  ip_adress  String?   @db.VarChar(45)
  Usuario    Usuario   @relation(fields: [Id_usuario], references: [Id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

enum Role {
  USER
  ADMIN
}
